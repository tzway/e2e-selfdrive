// .devcontainer/devcontainer.json
{
	"name": "e2e dev",
	// 多架构镜像,Docker 按主机平台自动选择:arm64(Apple Silicon)/ amd64(x86)
	"image": "mcr.microsoft.com/devcontainers/python:1-3.9-bookworm",
	// GPU 有则用、无则跳过:检测到 NVIDIA GPU 时自动追加 --gpus=all,Mac 上不会带
	"hostRequirements": {
		"gpu": "optional"
	},
	// 训练时防止 shm 过小导致崩溃
	"runArgs": [
		"--shm-size=2gb"
	],
	// 依赖安装脚本会按架构 / GPU 自动选择 CPU 或 CUDA 版本
	"postCreateCommand": "bash .devcontainer/postCreate.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter"
			]
		}
	}
}
